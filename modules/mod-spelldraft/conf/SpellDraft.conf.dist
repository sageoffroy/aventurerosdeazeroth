[worldserver]

############################################################
# Aventureros de Azeroth - SpellDraft
############################################################

# Activa/desactiva el sistema SpellDraft.
# Default: 1
SpellDraft.Enable = 1

############################################################
# Progresion de habilidades
############################################################

# Cantidad de habilidades elegidas al comenzar en nivel 1.
# Default: 3
SpellDraft.StartingDrafts = 3

# Primer nivel que concede una eleccion adicional despues del inicio.
# Default: 5
SpellDraft.FirstAdditionalDraftLevel = 5

# A partir del primer hito, cada cuantos niveles se concede otra eleccion.
# Ejemplo con 5: niveles 5, 10, 15, 20...
# Default: 5
SpellDraft.LevelsPerDraft = 5

# Cantidad de elecciones concedidas en cada hito.
# Default: 1
SpellDraft.DraftsPerMilestone = 1

# Maximo total de habilidades elegidas directamente por Draft.
# Las habilidades gratuitas recibidas mediante "teaches" no cuentan.
# 0 = sin limite.
# Default: 15
SpellDraft.MaxDraftedSpells = 15

############################################################
# Oferta de cartas
############################################################

# Cantidad de cartas mostradas en cada oferta.
# Rango soportado actualmente: 1-5.
# Default: 5
SpellDraft.OfferSize = 5

# Nivel minimo usado para determinar que cartas pueden entrar al pool.
# Permite que un personaje de nivel bajo tenga una oferta variada.
# Default: 20
SpellDraft.LowLevelPoolFloor = 20

############################################################
# Rerolls y bans
############################################################

# Rerolls disponibles al comenzar.
# Default: 3
SpellDraft.StartingRerolls = 3

# Bans disponibles al comenzar.
# Default: 3
SpellDraft.StartingBans = 3

# Rerolls adicionales por cada nivel nuevo alcanzado.
# 0 = no otorgar rerolls por nivel.
# Default: 0
SpellDraft.RerollsPerLevel = 0

# Bans adicionales por cada nivel nuevo alcanzado.
# 0 = no otorgar bans por nivel.
# Default: 0
SpellDraft.BansPerLevel = 0

############################################################
# Proteccion de cartas
############################################################

# Activa/desactiva la mecanica de proteger una carta para conservarla.
# Default: 1
SpellDraft.Protection.Enable = 1

# Protecciones disponibles al comenzar.
# Default: 3
SpellDraft.StartingProtections = 3

# Protecciones adicionales ganadas por cada nuevo draft que la progresion
# concede. Los drafts iniciales no generan este bonus.
# Default: 0
SpellDraft.ProtectionPerDraft = 0

############################################################
# Pesos de rareza
############################################################

# Son pesos relativos: no es obligatorio que sumen 100.
# Con los valores por defecto equivalen a 70 / 20 / 7 / 2.5 / 0.5 %.
SpellDraft.Rarity.Common = 70.0
SpellDraft.Rarity.Uncommon = 20.0
SpellDraft.Rarity.Rare = 7.0
SpellDraft.Rarity.Epic = 2.5
SpellDraft.Rarity.Legendary = 0.5

############################################################
# Talentos y metaprogresion de cuenta
############################################################

# Activa el carril de talentos separado del draft normal.
# Default: 1
SpellDraft.Talents.Enable = 1

# Primera eleccion de talento.
# Default: 10
SpellDraft.Talents.FirstLevel = 10

# Una nueva eleccion cada N niveles desde FirstLevel.
# Con 2: 10, 12, 14, 16... 80.
# Default: 2
SpellDraft.Talents.LevelsPerPick = 2

# Maximo de elecciones de talento por superviviente.
# De nivel 10 a 80 cada 2 niveles = 36.
# Default: 36
SpellDraft.Talents.MaxPicks = 36

# Cantidad de talentos mostrados por oferta.
# Default: 3
SpellDraft.Talents.OfferSize = 3

# Honor inicial para una cuenta sin metaprogresion previa.
# Default: 0
SpellDraft.Talents.StartingAccountHonor = 0
